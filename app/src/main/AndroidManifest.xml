<manifest xmlns:android="http://android.com"
    xmlns:tools="http://android.com">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".zedMoviesApplication"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/zed_movies_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/zed_movies_round"
        android:enableOnBackInvokedCallback="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.zedMovies.Splash"
        tools:replace="android:allowBackup,android:label,android:theme"
        tools:targetApi="tiramisu">

        <meta-data
            android:name="com.startapp.sdk.APPLICATION_ID"
            android:value="156899168" />

        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <activity
            android:name=".ui.webview.WebViewActivity"
            android:exported="false"
            android:theme="@style/Theme.NoActionbar.FullScreen.zedMovies"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard"
            android:windowSoftInputMode="adjustPan" />
        <activity
            android:name=".ui.trailer.TrailerActivity"
            android:exported="false"
            android:theme="@style/Theme.zedMovies.Trailer"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard" />
        <activity
            android:name=".zedMoviesActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
